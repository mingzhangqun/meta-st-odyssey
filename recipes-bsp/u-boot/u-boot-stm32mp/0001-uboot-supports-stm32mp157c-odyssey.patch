From 6bab7d00a837cedc7c1fa16d04610a66a8931116 Mon Sep 17 00:00:00 2001
From: mingzq <north_sea@qq.com>
Date: Fri, 14 Feb 2025 09:33:37 +0000
Subject: [PATCH 1/1] uboot: supports stm32mp157c-odyssey

---
 arch/arm/dts/stm32mp157c-odyssey-som.dtsi | 12 ++++++++--
 arch/arm/dts/stm32mp157c-odyssey.dts      | 27 +++++++++++++++++++++--
 board/st/stm32mp1/stm32mp1.c              |  3 ++-
 3 files changed, 37 insertions(+), 5 deletions(-)

diff --git a/arch/arm/dts/stm32mp157c-odyssey-som.dtsi b/arch/arm/dts/stm32mp157c-odyssey-som.dtsi
index 1510a5b364..f8cbae3595 100644
--- a/arch/arm/dts/stm32mp157c-odyssey-som.dtsi
+++ b/arch/arm/dts/stm32mp157c-odyssey-som.dtsi
@@ -15,8 +15,8 @@
 
 / {
 
-	model = "Seeed Studio Odyssey-STM32MP157C SOM";
-	compatible = "seeed,odyssey-stm32mp157c-som", "st,stm32mp157";
+	model = "Seeed Studio STM32MP157C-Odyssey SOM";
+	compatible = "seeed,stm32mp157c-odyssey-som", "st,stm32mp157";
 
 	memory@c0000000 {
 		device_type = "memory";
@@ -87,6 +87,14 @@
 
 };
 
+&cpu0{
+	cpu-supply = <&vddcore>;
+};
+
+&cpu1{
+	cpu-supply = <&vddcore>;
+};
+
 &gpu {
 	contiguous-area = <&gpu_reserved>;
 	status = "okay";
diff --git a/arch/arm/dts/stm32mp157c-odyssey.dts b/arch/arm/dts/stm32mp157c-odyssey.dts
index 17bcf56f74..024cb03ba4 100644
--- a/arch/arm/dts/stm32mp157c-odyssey.dts
+++ b/arch/arm/dts/stm32mp157c-odyssey.dts
@@ -9,8 +9,8 @@
 
 / {
 
-	model = "Seeed Studio Odyssey-STM32MP157C Board";
-	compatible = "seeed,odyssey-stm32mp157c", "st,stm32mp157";
+	model = "Seeed Studio STM32MP157C-Odyssey Board";
+	compatible = "seeed,stm32mp157c-odyssey", "st,stm32mp157";
 
 	aliases {
 		ethernet0 = &ethernet0;
@@ -31,6 +31,29 @@
 		};
 	};
 
+	firmware {
+		optee: optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+
+		scmi: scmi {
+			compatible = "linaro,scmi-optee";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			linaro,optee-channel-id = <0>;
+
+			scmi_clk: protocol@14 {
+				reg = <0x14>;
+				#clock-cells = <1>;
+			};
+
+			scmi_reset: protocol@16 {
+				reg = <0x16>;
+				#reset-cells = <1>;
+			};
+		};
+	};
 };
 
 &adc {
diff --git a/board/st/stm32mp1/stm32mp1.c b/board/st/stm32mp1/stm32mp1.c
index 30dd55538d..ef9cf25869 100644
--- a/board/st/stm32mp1/stm32mp1.c
+++ b/board/st/stm32mp1/stm32mp1.c
@@ -877,7 +877,8 @@ int board_late_init(void)
 		fdt_compat = ofnode_get_property(ofnode_root(), "compatible",
 						 &fdt_compat_len);
 		if (fdt_compat && fdt_compat_len) {
-			if (strncmp(fdt_compat, "st,", 3) != 0) {
+			if ((strncmp(fdt_compat, "st,", 3) != 0) \
+				|| (strncmp(fdt_compat, "seeed,", 6) != 0)) {
 				env_set("board_name", fdt_compat);
 			} else {
 				env_set("board_name", fdt_compat + 3);
-- 
2.43.0

